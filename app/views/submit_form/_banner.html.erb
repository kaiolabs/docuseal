<div class="flex mt-6 mb-5 px-4">
  <% account = @submitter&.account || current_account rescue nil %>
  <% if account&.company_logo&.attached? %>
    <div class="mx-auto flex items-center gap-5 md:gap-8">
      <%= image_tag account.company_logo, class: 'h-10 md:h-12 object-contain flex-shrink-0' %>
      <span class="text-2xl md:text-3xl font-bold text-[#1E3A5F]"><%= account.name %></span>
    </div>
  <% else %>
    <%= render 'submit_form/docuseal_logo' %>
  <% end %>
</div>
